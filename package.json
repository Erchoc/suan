{
  "name": "suan",
  "private": true,
  "version": "1.0.0",
  "description": "An intelligent elementary mathematics learning platform powered by a knowledge graph",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "cloudflare": {
    "bindings": {
      "BASE_URL": {
        "description": "AI provider base URL, for example https://api.deepseek.com."
      },
      "API_KEY": {
        "description": "AI provider API key. Cloudflare stores this value as an encrypted Worker secret."
      },
      "MODEL": {
        "description": "AI model identifier, for example deepseek-v4-flash."
      },
      "AI_PROTOCOL": {
        "description": "Upstream protocol: openai-chat, openai-coding, or anthropic."
      },
      "ADMIN_SESSION_SECRET": {
        "description": "A random secret with at least 24 characters for signing console sessions."
      }
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run",
    "deploy:production": "CLOUDFLARE_ENV=production pnpm build && CLOUDFLARE_ENV=production wrangler deploy",
    "deploy:production:dry": "CLOUDFLARE_ENV=production pnpm build && CLOUDFLARE_ENV=production wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --include-runtime false",
    "cf-typegen:check": "wrangler types --env-interface CloudflareBindings --include-runtime false --check",
    "typecheck": "tsc -b",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check:code": "biome check .",
    "check:code:fix": "biome check --write .",
    "pwa:assets": "pwa-assets-generator --config scripts/pwaAssets.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "pnpm cf-typegen:check && biome ci . && pnpm typecheck && pnpm test:coverage && pnpm build",
    "check": "pnpm run ci",
    "gen:questions": "tsx --env-file-if-exists=.env scripts/generateQuestions.ts",
    "gen:cards": "tsx --env-file-if-exists=.env scripts/generateKnowledgeCards.ts",
    "gen:fill": "tsx --env-file-if-exists=.env scripts/generateQuestions.ts --type fill_blank --append",
    "gen:choice": "tsx --env-file-if-exists=.env scripts/generateQuestions.ts --type choice --append",
    "gen:half": "tsx --env-file-if-exists=.env scripts/generateQuestions.ts --type half --append",
    "gen:auto": "tsx --env-file-if-exists=.env scripts/generateQuestions.ts --type auto --append",
    "gen:dry": "tsx --env-file-if-exists=.env scripts/generateQuestions.ts --dry-run",
    "validate:questions": "tsx --env-file-if-exists=.env scripts/validateQuestions.ts",
    "check:questions": "tsx --env-file-if-exists=.env scripts/checkQuestions.ts",
    "check:grade": "tsx --env-file-if-exists=.env scripts/checkQuestions.ts --grade",
    "check:kp": "tsx --env-file-if-exists=.env scripts/checkQuestions.ts --kp",
    "check:dry": "tsx --env-file-if-exists=.env scripts/checkQuestions.ts --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply CONTENT_DB --local",
    "db:migrate:production": "wrangler d1 migrations apply CONTENT_DB --remote --env production",
    "db:seed:generate": "tsx scripts/seedQuestionBank.ts",
    "db:seed:local": "pnpm db:seed:generate && wrangler d1 execute CONTENT_DB --local --file .wrangler/question-bank-seed.sql",
    "db:seed:production": "pnpm db:seed:generate && wrangler d1 execute CONTENT_DB --remote --env production --file .wrangler/question-bank-seed.sql"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@xyflow/react": "^12.11.2",
    "framer-motion": "^11.15.0",
    "hono": "^4.12.30",
    "lodash-es": "^4.18.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.9.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-istanbul": "4.1.10",
    "autoprefixer": "^10.5.4",
    "lefthook": "2.1.10",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.112.0"
  }
}
