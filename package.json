{
  "name": "suan",
  "private": true,
  "version": "1.0.0",
  "description": "基于知识图谱的小学数学智能学习平台",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --include-runtime false",
    "cf-typegen:check": "wrangler types --env-interface CloudflareBindings --include-runtime false --check",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm cf-typegen:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "gen:questions": "tsx scripts/generateQuestions.ts",
    "gen:cards": "tsx scripts/generateKnowledgeCards.ts",
    "gen:fill": "tsx scripts/generateQuestions.ts --type fill_blank --append",
    "gen:choice": "tsx scripts/generateQuestions.ts --type choice --append",
    "gen:half": "tsx scripts/generateQuestions.ts --type half --append",
    "gen:auto": "tsx scripts/generateQuestions.ts --type auto --append",
    "gen:dry": "tsx scripts/generateQuestions.ts --dry-run",
    "validate:questions": "tsx scripts/validateQuestions.ts",
    "check:questions": "tsx scripts/checkQuestions.ts",
    "check:grade": "tsx scripts/checkQuestions.ts --grade",
    "check:kp": "tsx scripts/checkQuestions.ts --kp",
    "check:dry": "tsx scripts/checkQuestions.ts --dry-run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@xyflow/react": "^12.11.2",
    "framer-motion": "^11.15.0",
    "hono": "^4.12.30",
    "lodash-es": "^4.18.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.9.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@eslint/js": "^9.39.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "openai": "^6.48.0",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.112.0"
  }
}
