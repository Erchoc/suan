# Copy this file to .env and replace API_KEY with a valid provider key.
BASE_URL=https://api.deepseek.com
API_KEY=sk-your-api-key
MODEL=deepseek-v4-flash
AI_PROTOCOL=openai-chat
# Use a unique random value with at least 24 characters for signing console sessions.
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# Optional domestic parent login. Leave these empty to show a clear unconfigured state.
USER_AUTH_SECRET=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
WECHAT_APP_ID=
WECHAT_APP_SECRET=
